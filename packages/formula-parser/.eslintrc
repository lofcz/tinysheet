{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["airbnb-base", "prettier"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "globals": {},
  "settings": {
    "import/core-modules": ["@formulajs/formulajs", "chevrotain"]
  },
  "rules": {
    "class-methods-use-this": 0,
    "no-undef": 0,
    "new-cap": 2,
    "eqeqeq": [1, "smart"],
    "no-bitwise": 0,
    "no-continue": 0,
    "no-eq-null": 1,
    "no-irregular-whitespace": 2,
    "no-loop-func": 1,
    "no-multi-str": 2,
    "no-new": 2,
    "no-param-reassign": 0,
    "no-plusplus": 0,
    "no-restricted-properties": 0,
    "no-restricted-syntax": 1,
    "no-shadow": 1,
    "no-template-curly-in-string": 0,
    "no-underscore-dangle": 0,
    "no-unused-vars": 1,
    "no-use-before-define": [
      2,
      { "functions": false, "classes": true, "variables": false }
    ],
    "no-void": 0,
    "no-with": 2,
    "object-shorthand": 1,
    "prefer-arrow-callback": 1,
    "prefer-const": 0,
    "prefer-rest-params": 1,
    "prefer-spread": 1,
    "prefer-template": 1,
    "arrow-body-style": [2, "as-needed"],
    "camelcase": [2, { "properties": "never" }],
    "import/prefer-default-export": 0,
    "no-unneeded-ternary": [2, { "defaultAssignment": true }],
    "no-console": [2, { "allow": ["error", "warn", "info"] }],
    "max-depth": [2, 5],
    "quote-props": [2, "as-needed"],
    "yoda": [2, "never"]
  }
}
