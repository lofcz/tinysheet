    "formula-parser",
    "formulas",
    "parser",
    "spreadsheet"
  ],
  "license": "MIT",
  "author": "Handsoncode <hello@handsontable.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/tinysheet.git",
    "directory": "packages/formula-parser"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
