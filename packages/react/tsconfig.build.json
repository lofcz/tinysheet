{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react",
    "strict": true,
    "strictNullChecks": true,
    "lib": ["es2020", "dom"],
    "rootDir": "./src",
    "baseUrl": "."
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
