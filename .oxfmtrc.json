{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "ignorePatterns": [
    "**/dist/**",
    "storybook-static/**",
    "packages/core/src/i18n/i18n-*.ts",
    "**/*.md",
    "bun.lock",
    "docs/**/node_modules/**",
    "docs/yarn.lock",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**"
  ],
  "printWidth": 80
}
