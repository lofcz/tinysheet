{
  "name": "tinysheet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/lofcz/tinysheet",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run storybook",
    "build": "node ./scripts/build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tsc": "tsc -p tsconfig.json && tsc -p tsconfig.excel.json",
    "typecheck": "bun run tsc",
    "lint": "oxlint",
    "postinstall": "bun run build",
    "test": "bun run test:formula-parser && bun run test:jest",
    "test:formula-parser": "bun run --cwd packages/formula-parser test",
    "test:jest": "jest",
    "test:excel": "bun run --cwd packages/excel test",
    "test:e2e": "node e2e/run.mjs",
    "docs:functions": "bun docs/scripts/generate-functions.ts",
    "coverage": "bun run --cwd packages/formula-parser coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.7",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-flow": "^8.0.1",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@rsbuild/core": "^2.2.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@storybook/addon-links": "^10.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@tsdown/css": "^0.22.14",
    "@types/jest": "^29.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^29.3.1",
    "express": "^4.17.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.3.1",
    "jest-canvas-mock": "^2.4.0",
    "jest-environment-jsdom": "^29.3.1",
    "lerna": "^4.0.0",
    "lint-staged": "^16.2.6",
    "mongodb": "^4.5.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "storybook": "^10.6.0",
    "storybook-react-rsbuild": "^3.6.0",
    "terser": "5.37.0",
    "tsdown": "^0.22.14",
    "ws": "^8.11.0",
    "yorkie": "^2.0.0"
  },
  "resolutions": {
    "terser": "5.37.0"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "5.37.0"
  },
  "packageManager": "bun@1.4.0",
  "gitHooks": {
    "pre-commit": "bun run lint"
  }
}
